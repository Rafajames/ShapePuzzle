{
  "rules": {
    ".read": false,
    ".write": false,
    "c": {
      "$id": {
        ".read": true,
        ".write": "auth != null && $id.length === 6 && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid && data.child('geral').val() !== true && (!newData.exists() || (!root.child('p').child($id).exists() && newData.child('uid').val() === auth.uid && newData.child('criado').val() === data.child('criado').val()))))",
        ".validate": "newData.hasChildren(['nome', 'org', 'max', 'modo', 'fim', 'criado', 'fases', 'uid'])",
        "uid": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "nome": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
        },
        "org": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 20"
        },
        "max": {
          ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 200"
        },
        "modo": {
          ".validate": "newData.val() === 'melhor' || newData.val() === 'primeira'"
        },
        "fim": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "criado": {
          ".validate": "newData.isNumber()"
        },
        "fases": {
          ".validate": "newData.hasChildren()",
          "$i": {
            ".validate": "newData.hasChildren(['nome', 'text']) && $i.matches(/^[0-9]$/)",
            "nome": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "$outro": {
              ".validate": false
            }
          }
        },
        "$outro": {
          ".validate": false
        },
        "geral": {
          ".validate": "newData.val() === true && $id.matches(/^0[0-9A-Z]{5}$/) && newData.parent().child('max').val() === 100 && newData.parent().child('criado').val() >= now - 600000 && newData.parent().child('criado').val() <= now + 600000 && newData.parent().child('fim').val() >= now && newData.parent().child('fim').val() <= now + 691200000"
        },
        "sem": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-W[0-9]{2}$/)"
        },
        "sala": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99"
        }
      }
    },
    "p": {
      "$id": {
        ".read": true,
        ".write": "auth != null && !newData.exists() && root.child('c').child($id).child('uid').val() === auth.uid",
        "$key": {
          ".write": "!data.exists() && newData.hasChildren(['n', 'ts']) && !newData.hasChild('f') && root.child('c').child($id).exists() && (!(root.child('c').child($id).child('geral').val() === true) || (auth != null && !root.child('ban').child(auth.uid).exists() && auth.uid.beginsWith($key) && ($key.length === 24 || $key === auth.uid) && newData.child('ts').val() <= now + 600000))",
          ".validate": "$key.length >= 2 && $key.length <= 24",
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 20"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "f": {
            "$i": {
              ".write": "root.child('p').child($id).child($key).child('n').exists() && root.child('c').child($id).exists() && (root.child('c').child($id).child('fim').val() === 0 || now <= root.child('c').child($id).child('fim').val()) && (!(root.child('c').child($id).child('geral').val() === true) || (auth != null && auth.uid.beginsWith($key) && ($key.length === 24 || $key === auth.uid))) && (!data.exists() || (root.child('c').child($id).child('modo').val() === 'melhor' && newData.child('t').val() < data.child('t').val()))",
              ".validate": "newData.hasChildren(['t', 'j']) && $i.matches(/^[0-9]$/)",
              "t": {
                ".validate": "newData.isNumber() && newData.val() >= 500 && newData.val() <= 86400000 && (!(root.child('c').child($id).child('geral').val() === true) || newData.val() >= 4000)"
              },
              "j": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5000 && (!(root.child('c').child($id).child('geral').val() === true) || newData.val() >= 5)"
              },
              "$outro": {
                ".validate": false
              }
            }
          },
          "$outro": {
            ".validate": false
          },
          "av": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "mold": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "fun": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          }
        }
      }
    },
    "pub": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid && (!newData.exists() || !root.child('ban').child($uid).exists())",
        ".validate": "newData.hasChildren(['nome', 'av', 'n'])",
        "nome": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 20"
        },
        "av": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "mold": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "n": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "fun": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "$outro": {
          ".validate": false
        }
      },
      ".read": true,
      ".indexOn": [
        "n"
      ]
    },
    "priv": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['d', 'ts'])",
        "d": {
          ".validate": "newData.isString() && newData.val().length <= 250000"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "cupons": {
      "$cod": {
        ".read": "$cod.matches(/^[A-Z0-9_-]{3,20}$/)",
        ".write": false
      }
    },
    "den": {
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['tipo', 'alvo', 'nome', 'motivo', 'ts'])",
        "tipo": {
          ".validate": "newData.val() === 'jogador' || newData.val() === 'camp'"
        },
        "alvo": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "sala": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "nome": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "motivo": {
          ".validate": "newData.val() === 'nome' || newData.val() === 'trapaca' || newData.val() === 'outro'"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() >= now - 600000 && newData.val() <= now + 600000"
        },
        "por": {
          ".validate": "newData.isString() && (newData.val() === '' || (auth != null && newData.val() === auth.uid))"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "ban": {
      ".read": false,
      ".write": false
    }
  }
}
